# ============================================================
# Event Attendance System — Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to version control.
# ============================================================

# ---- Database ----
# Local docker postgres on vmi3062768
DATABASE_URL=postgresql://eas:eas@localhost:5432/eas

# ---- Auth (admin) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_TOKEN_TTL=24h

# ---- QR signing (HS256) ----
# Generate with: openssl rand -base64 64
# NEVER expose this to the client. Used only on the server.
QR_HMAC_SECRET=replace-me-with-openssl-rand-base64-64

# ---- Server ----
API_PORT=4000
WEB_PORT=3011
SCANNER_PORT=5173
PUBLIC_BASE_URL=https://eas.arrowtest.site

# ---- CORS ----
# Comma-separated list of allowed origins.
# Dev: the scanner (Vite :5173) and the web (Next.js :3011) hit the api (:4000).
CORS_ORIGIN=http://localhost:3011,http://localhost:5173,https://web.eas.arrowtest.site,https://scanner.eas.arrowtest.site

# ---- Scanner telemetry (v1) ----
# Geo coords are opt-in. Set to false to strip lat/lng from the attendance POST.
ENABLE_SCANNER_GEO=true

# ---- Seed (used by `pnpm --filter @eas/api seed`) ----
# The seed script creates the LLCC test org + admin user.
SEED_ORG_NAME=Lapu-Lapu City College
SEED_ORG_SLUG=llcc
SEED_ORG_TYPE=SCHOOL
SEED_ADMIN_EMAIL=admin@llcc.eas.arrowtest.site
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NAME=LLCC Admin

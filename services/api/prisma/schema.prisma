// EAS Prisma schema — v1
// See event-attendance-system-prompt.md §2 for the locked shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  SCHOOL
  ORG
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AttendanceSource {
  SCAN
  MANUAL
  IMPORT
}

enum UserRole {
  admin
  attendee
}

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  type      OrgType
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  users     User[]
  events    Event[]
  attendees Attendee[]

  @@index([slug])
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  passwordHash   String
  name           String
  role              UserRole @default(admin)
  createdAt         DateTime @default(now())
  deletedAt         DateTime? // soft-delete tombstone; null = active
  // Setup-link single-use marker (v1.1.1)
  setupTokenJti     String?  // jti stored when a setup token is issued; cleared after first use
  setupTokenUsedAt  DateTime? // set when the setup token is consumed

  organization      Organization @relation(fields: [organizationId], references: [id])
  events            Event[]
  attendeeAccount   Attendee?    @relation("AttendeeUser")

  // NOTE: email uniqueness is a PARTIAL index in raw SQL
  // (see migration 20260716004000_user_soft_delete) — only enforced while the
  // user is active (deletedAt IS NULL). Prisma can't model partial uniques,
  // so we rely on the migration-managed index. Do NOT add @unique back here.
  @@index([organizationId])
  @@index([deletedAt])
}

model Attendee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  identifier     String
  fullName       String
  email          String
  userId         String?   @unique @db.Uuid
  qrSecret       String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  photoUrl       String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime? // soft-delete tombstone; null = active

  organization Organization         @relation(fields: [organizationId], references: [id])
  user         User?                @relation("AttendeeUser", fields: [userId], references: [id], onDelete: SetNull)
  records     AttendanceRecord[]
  rosters     EventRoster[]

  // NOTE: The (organizationId, identifier) unique is a PARTIAL index in raw SQL
  // (see migration 20260716001950_attendee_soft_delete) — only enforced while
  // the row is active (deletedAt IS NULL). Prisma can't model partial uniques,
  // so we rely on the migration-managed index. Do NOT add @@unique back here.
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Event {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  name           String
  description    String?
  location       String?
  startsAt       DateTime
  endsAt         DateTime
  status         EventStatus @default(DRAFT)
  createdById    String      @db.Uuid
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?
  // Geofence — if locationLat/lng set, scans outside radiusM are flagged (not rejected)
  locationLat    Decimal?    @db.Decimal(13, 10)
  locationLng    Decimal?    @db.Decimal(13, 10)
  geofenceRadiusM Int        @default(50)

  organization Organization       @relation(fields: [organizationId], references: [id])
  createdBy    User               @relation(fields: [createdById], references: [id])
  rosters      EventRoster[]
  records      AttendanceRecord[]

  @@index([organizationId, startsAt])
  @@index([status])
}

model EventRoster {
  eventId    String   @db.Uuid
  attendeeId String   @db.Uuid
  addedAt    DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@id([eventId, attendeeId])
  @@index([attendeeId])
}

model AttendanceRecord {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String           @db.Uuid
  attendeeId      String           @db.Uuid
  idempotencyKey  String           @db.Uuid
  scannedAt       DateTime
  createdAt       DateTime         @default(now())
  source          AttendanceSource @default(SCAN)
  scannerLat      Decimal?         @db.Decimal(13, 10)
  scannerLng      Decimal?         @db.Decimal(13, 10)
  scannerDeviceId String?
  note            String?
  // Geofence audit fields — flagged (not rejected) when scanner is outside event radius
  outsideGeofence Boolean          @default(false)
  distanceM       Decimal?         @db.Decimal(10, 2)
  geofenceSkipped Boolean          @default(false) // true if scanner denied/unsupported geolocation

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([eventId, idempotencyKey])
  @@unique([eventId, attendeeId])
  @@index([eventId, scannedAt])
  @@index([attendeeId, scannedAt])
}

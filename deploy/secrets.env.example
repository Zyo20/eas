# /etc/eas/secrets.env — sourced by pm2.ecosystem.config.cjs
# Permissions: chmod 600, owned by root or pm2 user.
#
# Generate with:
#   openssl rand -base64 32  (use as AUTH_SECRET)
#   openssl rand -base64 64  (use as QR_HMAC_SECRET)
#
# DATABASE_URL matches the eas-pg docker container on vmi3062768:
#   docker exec eas-pg env | grep POSTGRES_PASSWORD
# then build: postgresql://eas:<that-password>@localhost:5432/eas

EAS_DATABASE_URL=postgresql://eas:YOUR_EAS_PG_PASSWORD@localhost:5432/eas
EAS_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32
EAS_QR_HMAC_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_64
